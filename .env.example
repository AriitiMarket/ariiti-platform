# ==============================================================================
# ARIITI TECH - CORPORATE PLATFORM ENVIRONMENT CONFIGURATION
# Copy this file to .env.local and populate secrets for local development.
# ==============================================================================

# Database Connection (MongoDB Atlas or Local Instance)
MONGODB_URI="mongodb+srv://<user>:<password>@cluster0.mongodb.net/ariiti_platform?retryWrites=true&w=majority"

# NextAuth.js Configuration (Authentication & Session Management)
NEXTAUTH_SECRET="your-super-secret-key"
NEXTAUTH_URL="http://localhost:3000"

# Direct Lead Conversion & Customer Contact
NEXT_PUBLIC_WHATSAPP_NUMBER="251900000000"

# Telegram Bot Alerts (Instant Lead Dispatch to Operations Team)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Cloudinary Media Storage (Case Study Proof, Product Media, Service Assets)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
